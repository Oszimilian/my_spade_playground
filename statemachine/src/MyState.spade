enum State<T> {
    Idle,
    state_a{duration : T},
    state_b{duration : T},
    state_c{duration : T}
}

fn all_ones<#uint T>() -> uint<T> {
    ~0
}

entity MyState<T>(clk : clock, rst : bool) -> T {
    

    
    reg(clk) cnt : uint<5> reset(rst : 0) = 

        if cnt < all_ones::<5>() {
            trunc(cnt + 1)
        } 
        else {
            0
        };

    let up = if cnt == 0 {
        true
    } else {
        false
    };
        

    reg(clk) state : State<T> reset(rst : State::Idle) = 
        match(state) {
            State::Idle => {
                State::state_a$(duration : 30)
            },
            State::state_a$(duration : 0) => {
                State::state_b$(duration : 40)
            },
            State::state_a$(duration) => {
                if up {
                    State::state_a$(duration : trunc(duration - 1))
                } else {
                    state
                }
                
            },
            State::state_b$(duration : 0) => {
                State::state_c$(duration : 50)
            },
            State::state_b$(duration) => {
                if up {
                    State::state_b$(duration : trunc(duration - 1))
                } else {
                    state
                }
            },
            State::state_c$(duration : 0) => {
                State::Idle
            },
            State::state_c$(duration) => {
                if up {
                    State::state_c$(duration : trunc(duration - 1))
                } else {
                    state
                }
            },

        };

    
    let ret = match(state) {
        State::state_a(duration) => {
            duration
        },
        State::state_b(duration) => {
            duration
        },
        State::state_c(duration) => {
            duration
        },
        _ => {
            0
        }
    };

    ret
    
}